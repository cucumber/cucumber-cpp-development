{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 21
    },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "On"
            }
        },
        {
            "name": "host-system",
            "displayName": "Host build (system dependencies)",
            "description": "Build and install the library using C++ dependencies already installed on the system.",
            "inherits": "base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "test-system",
            "displayName": "Test build (system dependencies)",
            "description": "Build with unit tests and sanitizers enabled using system dependencies. Used by CI to build and run the test suite.",
            "inherits": "base",
            "cacheVariables": {
                "CUCUMBER_MESSAGES_BUILD_TESTS": "On",
                "CUCUMBER_QUERY_BUILD_TESTS": "On",
                "CUCUMBER_TAG_EXPRESSIONS_BUILD_TESTS": "On",
                "CUCUMBER_PRETTY_FORMATTER_BUILD_TESTS": "On",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "host-system",
            "configurePreset": "host-system"
        },
        {
            "name": "test-system",
            "configurePreset": "test-system"
        }
    ],
    "testPresets": [
        {
            "name": "test-system",
            "configurePreset": "test-system",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error"
            }
        }
    ],
    "workflowPresets": [
        {
            "name": "host-system",
            "steps": [
                {
                    "name": "host-system",
                    "type": "configure"
                },
                {
                    "name": "host-system",
                    "type": "build"
                }
            ]
        },
        {
            "name": "test-system",
            "steps": [
                {
                    "name": "test-system",
                    "type": "configure"
                },
                {
                    "name": "test-system",
                    "type": "build"
                },
                {
                    "name": "test-system",
                    "type": "test"
                }
            ]
        }
    ]
}
